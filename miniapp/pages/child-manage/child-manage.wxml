<view class="page-content">
    <view wx:if="{{list.length == 0}}" class="empty-state"><text class="empty-icon">👶</text><text>还没有添加宝宝信息</text><text style="font-size:13px;color:var(--text-hint)">点击下方按钮添加宝宝，开始筛查</text></view>
    <view wx:for="{{list}}" wx:key="id" class="child-card">
        <view class="child-info" bindtap="goScreening" data-id="{{item.id}}">
            <text class="child-avatar">{{item.avatar || '👶'}}</text>
            <view>
                <view class="child-name-row">
                    <text class="child-name">{{item.name}}</text>
                    <text wx:if="{{item.isPremature}}" class="child-tag-premature">早产</text>
                </view>
                <text class="child-detail">{{item.gender === 'male' ? '👦' : '👧'}} {{item.ageText}} · {{item.birthFmt}}</text>
                <text wx:if="{{item.isCorrected}}" class="child-detail-corrected">📐 矫正月龄：{{item.correctedAgeText}}（用于量表匹配）</text>
            </view>
        </view>
        <view class="child-actions"><text bindtap="editChild" data-id="{{item.id}}">✏️</text><text bindtap="deleteChild" data-id="{{item.id}}">🗑️</text></view>
    </view>
    <button class="btn btn-outline btn-block" bindtap="showForm" wx:if="{{!showForm}}">+ 添加宝宝</button>

    <view wx:if="{{showForm}}" class="card">
        <text class="card-title">{{editingId ? '编辑宝宝信息' : '添加宝宝信息'}}</text>
        <view class="form-group"><text class="form-label">宝宝昵称</text><input class="form-input" placeholder="请输入宝宝昵称" value="{{form.name}}" bindinput="onFName" /></view>
        <view class="form-group"><text class="form-label">性别</text>
            <view class="gender-row">
                <view class="gender-btn {{form.gender==='male'?'selected':''}}" bindtap="onGender" data-g="male">👦 男宝</view>
                <view class="gender-btn {{form.gender==='female'?'selected':''}}" bindtap="onGender" data-g="female">👧 女宝</view>
            </view>
        </view>
        <view class="form-group"><text class="form-label">出生日期</text>
            <picker mode="date" end="{{today}}" bindchange="onDate"><view class="form-input picker-like">{{form.birth || '请选择出生日期'}}</view></picker>
        </view>
        <view class="form-group"><text class="form-label">是否早产</text>
            <view class="gender-row">
                <view class="gender-btn {{form.isPremature===true?'selected':''}}" bindtap="onPremature" data-v="{{true}}">是</view>
                <view class="gender-btn {{form.isPremature===false?'selected':''}}" bindtap="onPremature" data-v="{{false}}">否</view>
            </view>
        </view>
        <view wx:if="{{form.isPremature===true}}" class="form-group"><text class="form-label">早产周数</text>
            <input class="form-input" type="number" placeholder="请输入早产周数" value="{{form.prematureWeeks}}" bindinput="onPrematureWeeks" />
            <view class="premature-hint">
                <text class="premature-hint-icon">💡</text>
                <text class="premature-hint-text">若宝宝为早产儿，系统将自动计算矫正月龄用于量表评估；宝宝满24个实际月龄后不再矫正。</text>
            </view>
        </view>
        <view class="form-group"><text class="form-label">居住地市</text>
            <input class="form-input" placeholder="请输入居住地市" value="{{form.city}}" bindinput="onCity" />
        </view>
        <view class="form-group"><text class="form-label">头像</text>
            <view class="avatar-row"><text wx:for="{{avatars}}" wx:key="*this" class="avatar-opt {{form.avatar===item?'selected':''}}" bindtap="onAvatar" data-a="{{item}}">{{item}}</text></view>
        </view>

        <!-- 照护者信息 -->
        <view class="section-divider"><text class="section-divider-text">📋 照护者信息（选填，用于筛查评估参考）</text></view>

        <view class="form-group"><text class="form-label">照护者姓名</text><input class="form-input" placeholder="请输入照护者姓名" value="{{caregiver.name}}" bindinput="onCgName" /></view>

        <view class="form-group"><text class="form-label">照护者性别</text>
            <view class="gender-row">
                <view class="gender-btn {{caregiver.gender==='male'?'selected':''}}" bindtap="onCgGender" data-g="male">👨 男</view>
                <view class="gender-btn {{caregiver.gender==='female'?'selected':''}}" bindtap="onCgGender" data-g="female">👩 女</view>
            </view>
        </view>

        <view class="form-group"><text class="form-label">照护者年龄</text><input class="form-input" type="number" placeholder="请输入年龄" value="{{caregiver.age}}" bindinput="onCgAge" /></view>

        <view class="form-group"><text class="form-label">照顾者关系</text>
            <picker mode="selector" range="{{relationOptions}}" bindchange="onCgRelation">
                <view class="form-input picker-like">{{caregiver.relationship || '请选择与宝宝的关系'}}</view>
            </picker>
        </view>

        <view class="form-group"><text class="form-label">是否单亲</text>
            <view class="gender-row">
                <view class="gender-btn {{caregiver.is_single_parent==='是'?'selected':''}}" bindtap="onCgSingle" data-v="是">是</view>
                <view class="gender-btn {{caregiver.is_single_parent==='否'?'selected':''}}" bindtap="onCgSingle" data-v="否">否</view>
            </view>
        </view>

        <view class="form-group"><text class="form-label">教育程度</text>
            <picker mode="selector" range="{{educationOptions}}" bindchange="onCgEducation">
                <view class="form-input picker-like">{{caregiver.education || '请选择教育程度'}}</view>
            </picker>
        </view>

        <view class="form-group"><text class="form-label">家庭收入</text>
            <picker mode="selector" range="{{incomeOptions}}" bindchange="onCgIncome">
                <view class="form-input picker-like">{{caregiver.income || '请选择家庭月收入'}}</view>
            </picker>
        </view>

        <view class="form-btns"><button class="btn btn-outline" bindtap="cancelForm">取消</button><button class="btn btn-primary" bindtap="saveChild">保存</button></view>
    </view>
</view>
