<view class="page-content">
    <view wx:if="{{loading}}" class="empty-state">
        <text>加载中...</text>
    </view>
    <view wx:elif="{{empty}}" class="empty-state">
        <text>暂无历程记录</text>
        <text>完成筛查后将在此显示您的完整历程</text>
    </view>
    <view wx:else class="timeline">
        <block wx:for="{{events}}" wx:key="id">
            <view class="timeline-date-label" wx:if="{{item.showDateLabel}}">
                <text>{{item.dateDisplay}}</text>
            </view>
            <view class="timeline-node">
                <view class="timeline-left">
                    <view class="timeline-dot {{item.dotClass}}">
                        <text>{{item.iconEmoji}}</text>
                    </view>
                    <view class="timeline-line" wx:if="{{item.showLine}}"></view>
                </view>
                <view class="timeline-card">
                    <text>{{item.title}}</text>
                    <text>{{item.description}}</text>
                    <view wx:if="{{item.isMissed}}">
                        <text>提示：请关注对应月龄发育指标</text>
                    </view>
                </view>
            </view>
        </block>
    </view>
</view>
