.timeline {
    padding-left: 12px;
}

/* 日期分组标签 */
.timeline-date-label {
    padding: 16px 0 8px 0;
    margin-left: -12px;
}
.date-text {
    font-size: 14px;
    color: var(--text-secondary);
    font-weight: 500;
}

/* 时间轴节点行 */
.timeline-node {
    display: flex;
    align-items: flex-start;
    padding-bottom: 0;
}

/* 左侧：圆点 + 垂直连线 */
.timeline-left {
    width: 44px;
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
}

.timeline-dot {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    z-index: 2;
    flex-shrink: 0;
}

/* 5 种节点颜色 */
.dot-primary { background: #F3E5F5; color: var(--primary); }
.dot-success { background: #E8F8F0; color: var(--risk-low); }
.dot-info    { background: #E8F4FD; color: #2980B9; }
.dot-warning { background: #FEF3E2; color: var(--risk-medium); }
.dot-accent  { background: #FFF8E1; color: var(--accent); }
.dot-danger { background: #FDEDEC; color: var(--risk-high); }
.dot-default { background: #F0F0F0; color: var(--text-secondary); }

.dot-icon {
    font-size: 14px;
    line-height: 1;
}

.timeline-line {
    flex: 1;
    width: 2px;
    min-height: 20px;
    background: var(--border);
}

/* 右侧：事件卡片 */
.timeline-card {
    flex: 1;
    background: #fff;
    border-radius: var(--radius-sm);
    padding: 12px 14px;
    margin-left: 10px;
    margin-bottom: 12px;
}

.timeline-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 4px;
}

.timeline-card-title {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
}

.timeline-status {
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 10px;
}
.status-ok      { background: #E8F8F0; color: var(--risk-low); }
.status-pending { background: #FEF3E2; color: var(--risk-medium); }

.timeline-card-desc {
    font-size: 13px;
    color: var(--text-secondary);
    display: block;
    line-height: 1.5;
}

/* 额外信息行（筛查得分/风险，转诊医院/时间） */
.timeline-extra {
    margin-top: 8px;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
}

.extra-item {
    font-size: 12px;
    color: var(--text-secondary);
    background: var(--bg-page);
    padding: 2px 8px;
    border-radius: 4px;
}

.risk-tag {
    font-weight: 600;
}
/* 跳过阶段补充提示 */
.timeline-missed {
    padding-top: 2px;
}
.missed-hint {
    font-size: 12px;
    color: var(--risk-medium);
    background: var(--risk-medium-bg);
    padding: 3px 8px;
    border-radius: 4px;
    border-left: 3px solid var(--risk-medium);
}
