.page { background: #f5f0f5; min-height: 100vh; padding-bottom: 20px; }

/* ===== 顶部头部 ===== */
.header { background: linear-gradient(135deg, #6B1D5E 0%, #8B3A7B 100%); padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; }
.header-title { font-size: 20px; font-weight: 700; color: #fff; }
.header-bell { position: relative; }
.bell-icon { font-size: 24px; }
.bell-badge { position: absolute; top: -4px; right: -6px; background: #e74c3c; color: #fff; font-size: 10px; width: 16px; height: 16px; border-radius: 8px; text-align: center; line-height: 16px; }

/* ===== 紧凑型 ABCD 多选标签 ===== */
.grade-tags { display: flex; flex-wrap: nowrap; gap: 6px; padding: 12px 16px; }

/* 未选中的独立基础样式（浅灰底+灰边+深灰字） */
.grade-tag-gray {
    display: flex !important; align-items: center !important; gap: 4px !important;
    padding: 4px 10px !important; border-radius: 20px !important;
    background: #F2F2F2 !important;
    border: 1px solid #E0E0E0 !important;
    color: #999999 !important;
    font-size: 12px !important;
}

/* 选中的独立基础样式（合并统一 flex 结构） */
.grade-tag-active {
    display: flex !important; align-items: center !important; gap: 4px !important;
    padding: 4px 10px !important; border-radius: 20px !important;
    font-size: 12px !important; color: #fff !important;
}

/* 选中时的配色强制覆盖 */
.active-a { background: #E74C3C !important; border-color: #E74C3C !important; }
.active-b { background: #F39C12 !important; border-color: #F39C12 !important; }
.active-c { background: #3498DB !important; border-color: #3498DB !important; }
.active-d { background: #2ECC71 !important; border-color: #2ECC71 !important; }

.tag-check { font-size: 11px; margin-right: 2px; }
.tag-label { font-weight: 600; }
.tag-desc { font-size: 11px; opacity: 0.8; }

/* ===== 功能矩阵 ===== */
.func-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 2px; padding: 0 16px 16px; }
.func-item { background: #fff; padding: 16px 6px; text-align: center; border-radius: 2px; display: flex; flex-direction: column; align-items: center; }
.func-icon { font-size: 26px; }
.func-label { font-size: 11px; color: #666; margin-top: 4px; }

/* ===== 状态 ===== */
.status-wrap { display: flex; flex-direction: column; align-items: center; padding: 40px 0; }
.status-text { font-size: 14px; color: #999; margin-top: 12px; }
.error-text { font-size: 14px; color: #e74c3c; text-align: center; }
.retry-btn { margin-top: 16px; padding: 8px 24px; background: #6B1D5E; color: #fff; border-radius: 20px; font-size: 14px; }
.loading-spinner { width: 32px; height: 32px; border: 3px solid #e8d5e8; border-top-color: #6B1D5E; border-radius: 50%; animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

/* ===== 列表 ===== */
.list-section { padding: 0 16px; }
.region-group { margin-bottom: 16px; }
.region-title { font-size: 16px; font-weight: 600; color: #6B1D5E; display: block; margin-bottom: 8px; }

.hospital-card { background: #fff; border-radius: 12px; padding: 14px 16px; margin-bottom: 10px; }
.card-name-row { display: flex; justify-content: space-between; align-items: center; }
.inst-name { font-size: 16px; font-weight: 600; flex: 1; }
.inst-grade { font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 4px; color: #fff; }
.grade-A { background: #e74c3c; } .grade-B { background: #e8a838; } .grade-C { background: #3498db; } .grade-D { background: #2ecc71; }
.inst-grade-label { font-size: 12px; color: #999; display: block; margin-top: 2px; }

.card-scores { display: flex; justify-content: space-between; margin-top: 8px; padding: 8px 12px; background: #f8f0f8; border-radius: 6px; }
.score-item { font-size: 13px; color: #666; }
.score-val { font-weight: 600; color: #6B1D5E; }

.card-meta { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
.meta-item { font-size: 11px; color: #999; background: #f5f5f5; padding: 2px 8px; border-radius: 4px; }
.inst-info { font-size: 13px; color: #999; display: block; margin-top: 6px; }

/* ===== 地图 ===== */
.map-section { padding: 0 16px; }
.map-view { width: 100%; height: 400px; border-radius: 12px; }

/* ===== 付费弹窗 ===== */
.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: center; justify-content: center; }
.modal-box { background: #fff; border-radius: 16px; padding: 28px 24px; width: 300px; text-align: center; }
.modal-title { font-size: 18px; font-weight: 700; display: block; }
.modal-desc { font-size: 14px; color: #999; display: block; margin-top: 6px; }
.modal-price { font-size: 40px; font-weight: 700; color: #e74c3c; display: block; margin-top: 16px; }
.price-unit { font-size: 16px; font-weight: 400; }
.modal-note { font-size: 12px; color: #999; display: block; margin-top: 8px; }
.modal-btns { display: flex; gap: 10px; margin-top: 20px; }
.modal-btn { flex: 1; padding: 10px 0; border-radius: 8px; font-size: 14px; text-align: center; }
.modal-btn.cancel { background: #f0f0f0; color: #666; }
.modal-btn.confirm { background: #6B1D5E; color: #fff; }
