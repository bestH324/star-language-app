.page { background: #f5f0f5; min-height: 100vh; padding-bottom: 20px; }

/* ===== 顶部头部 ===== */
.header { background: linear-gradient(135deg, #6B1D5E 0%, #8B3A7B 100%); padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; }
.header-title { font-size: 20px; font-weight: 700; color: #fff; }
.header-bell { position: relative; }
.bell-icon { font-size: 24px; }
.bell-badge { position: absolute; top: -4px; right: -6px; background: #e74c3c; color: #fff; font-size: 10px; width: 16px; height: 16px; border-radius: 8px; text-align: center; line-height: 16px; }

/* ===== 紧凑型 ABCD 多选标签 ===== */
.grade-tags { display: flex; flex-wrap: nowrap; gap: 6px; padding: 12px 16px; }

/* 共用基础布局 */
.grade-tag {
    display: flex; align-items: center; justify-content: center; gap: 4px;
    padding: 4px 10px; border-radius: 20px;
    font-size: 12px; border: 1px solid transparent;
}

/* 未选中态：浅灰底 + 灰色文字（定义在前，选中态的品牌色会覆盖它） */
.grade-tag-gray {
    background: #f0f0f0;
    border-color: #E0E0E0;
    color: #999999;
}

/* 选中态：白字 + 各等级品牌色背景（定义在后，覆盖灰色） */
.grade-tag-active { color: #fff; }
.active-A { background: #E74C3C; border-color: #E74C3C; }
.active-B { background: #F39C12; border-color: #F39C12; }
.active-C { background: #3498DB; border-color: #3498DB; }
.active-D { background: #2ECC71; border-color: #2ECC71; }

.tag-check { font-size: 11px; margin-right: 2px; }
.tag-label { font-weight: 600; }
.tag-desc { font-size: 11px; opacity: 0.8; }

/* ===== 功能矩阵 ===== */
.func-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 2px; padding: 0 16px 16px; }
.func-item { background: #fff; padding: 16px 6px; text-align: center; border-radius: 2px; display: flex; flex-direction: column; align-items: center; }
.func-icon { font-size: 26px; }
.func-label { font-size: 11px; color: #666; margin-top: 4px; }

/* ===== 状态 ===== */
.status-wrap { display: flex; flex-direction: column; align-items: center; padding: 40px 0; }
.status-text { font-size: 14px; color: #999; margin-top: 12px; }
.error-text { font-size: 14px; color: #e74c3c; text-align: center; }
.retry-btn { margin-top: 16px; padding: 8px 24px; background: #6B1D5E; color: #fff; border-radius: 20px; font-size: 14px; }
.loading-spinner { width: 32px; height: 32px; border: 3px solid #e8d5e8; border-top-color: #6B1D5E; border-radius: 50%; animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

/* ===== 列表 ===== */
.list-section { padding: 0 16px; }
.region-group { margin-bottom: 16px; }
.region-title { font-size: 16px; font-weight: 600; color: #6B1D5E; display: block; margin-bottom: 8px; }

.hospital-card { background: #fff; border-radius: 12px; padding: 14px 16px; margin-bottom: 10px; }
.card-name-row { display: flex; justify-content: space-between; align-items: center; }
.inst-name { font-size: 16px; font-weight: 600; flex: 1; }
.inst-grade { font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 4px; color: #fff; }
.grade-A { background: #e74c3c; } .grade-B { background: #e8a838; } .grade-C { background: #3498db; } .grade-D { background: #2ecc71; }
.inst-grade-label { font-size: 12px; color: #999; display: block; margin-top: 2px; }

.card-scores { display: flex; justify-content: space-between; margin-top: 8px; padding: 8px 12px; background: #f8f0f8; border-radius: 6px; }
.score-item { font-size: 13px; color: #666; }
.score-val { font-weight: 600; color: #6B1D5E; }

.card-meta { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
.meta-item { font-size: 11px; color: #999; background: #f5f5f5; padding: 2px 8px; border-radius: 4px; }
.inst-info { font-size: 13px; color: #999; display: block; margin-top: 6px; }

/* ===== 总览缩略 thumb 网格模式 ===== */
.mode-thumb { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24rpx; padding: 30rpx; box-sizing: border-box; width: 100%; }
.thumb-card { background: #fff; border-radius: 12px; padding: 20rpx; text-align: center; display: flex; flex-direction: column; align-items: center; box-sizing: border-box; }
.thumb-avatar { width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-bottom: 8px; }
.thumb-avatar-text { font-size: 20px; font-weight: 700; color: #fff; }
.grade-bg-A { background: #E74C3C; }
.grade-bg-B { background: #F39C12; }
.grade-bg-C { background: #3498DB; }
.grade-bg-D { background: #2ECC71; }
.thumb-name { font-size: 14px; font-weight: 600; color: #333; display: block; margin-bottom: 4px; }
.thumb-grade { margin-bottom: 8px; }
.thumb-score { display: flex; align-items: baseline; gap: 4px; }
.thumb-score-label { font-size: 11px; color: #999; }
.thumb-score-val { font-size: 18px; font-weight: 700; color: #6B1D5E; }

/* ===== 评分排行 rank 模式 ===== */
.rank-row { display: flex; align-items: center; background: #fff; border-radius: 12px; padding: 14px 16px; margin-bottom: 8px; }
.rank-index { width: 40px; text-align: center; flex-shrink: 0; }
.rank-medal { font-size: 24px; }
.rank-num { font-size: 16px; font-weight: 700; color: #999; }
.rank-info { flex: 1; min-width: 0; }
.rank-name { font-size: 15px; font-weight: 600; color: #333; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rank-meta-row { display: flex; align-items: center; gap: 8px; margin-top: 4px; }
.rank-dist { font-size: 12px; color: #999; }
.rank-score-box { text-align: center; flex-shrink: 0; margin-left: 8px; }
.rank-score-num { font-size: 20px; font-weight: 700; color: #6B1D5E; display: block; }
.rank-score-label { font-size: 10px; color: #999; }

/* ===== 按城市选择 city 模式 ===== */
.city-bar { display: flex; align-items: center; background: #fff; border-radius: 10px; padding: 12px 16px; margin-bottom: 12px; }
.city-bar-icon { font-size: 20px; margin-right: 8px; }
.city-bar-text { flex: 1; font-size: 15px; font-weight: 600; color: #333; }
.city-bar-arrow { font-size: 12px; color: #999; }
.city-grid { display: flex; flex-wrap: wrap; gap: 12px; padding: 0 4px 16px; }
.city-item { padding: 10px 20px; background: #f5f5f5; border-radius: 20px; font-size: 14px; color: #666; text-align: center; }
.city-item-active { background: #6B1D5E; color: #fff; }

/* ===== 按地区选择 region 模式 ===== */
.region-block { margin-bottom: 16px; }
.region-header { font-size: 15px; font-weight: 700; color: #333; background: #f0f0f0; padding: 8px 16px; border-radius: 6px; margin-bottom: 8px; position: sticky; top: 0; z-index: 10; }

/* ===== 地图 ===== */
.map-section { padding: 0 16px; }
.map-view { width: 100%; height: 400px; border-radius: 12px; }

/* ===== 列表浏览底部弹窗 ===== */
.sheet-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.4); z-index: 1100; display: flex; align-items: flex-end; justify-content: center; }
.sheet-panel { width: 100%; background: #fff; border-radius: 16rpx 16rpx 0 0; padding: 20px 16px 32px; }
.sheet-title { font-size: 16px; font-weight: 600; color: #333; text-align: center; display: block; margin-bottom: 16px; }
.sheet-option { display: flex; align-items: center; padding: 16px 12px; }
.sheet-option-icon { font-size: 22px; margin-right: 12px; }
.sheet-option-label { font-size: 15px; color: #333; }
.sheet-divider { height: 1px; background: #eee; margin: 0 12px; }
.sheet-cancel { text-align: center; padding: 14px 0; font-size: 15px; color: #999; margin-top: 8px; }

/* ===== 付费弹窗 ===== */
.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: center; justify-content: center; }
.modal-box { background: #fff; border-radius: 16px; padding: 28px 24px; width: 300px; text-align: center; }
.modal-title { font-size: 18px; font-weight: 700; display: block; }
.modal-desc { font-size: 14px; color: #999; display: block; margin-top: 6px; }
.modal-price { font-size: 40px; font-weight: 700; color: #e74c3c; display: block; margin-top: 16px; }
.price-unit { font-size: 16px; font-weight: 400; }
.modal-note { font-size: 12px; color: #999; display: block; margin-top: 8px; }
.modal-btns { display: flex; gap: 10px; margin-top: 20px; }
.modal-btn { flex: 1; padding: 10px 0; border-radius: 8px; font-size: 14px; text-align: center; }
.modal-btn.cancel { background: #f0f0f0; color: #666; }
.modal-btn.confirm { background: #6B1D5E; color: #fff; }
