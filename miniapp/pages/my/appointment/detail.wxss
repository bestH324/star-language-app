.page { background: #f5f0f5; min-height: 100vh; }

.header { background: linear-gradient(135deg, #6B1D5E 0%, #8B3A7B 100%); padding: 16px 20px; display: flex; align-items: center; gap: 12px; }
.header-back { font-size: 14px; color: rgba(255,255,255,0.8); flex-shrink: 0; }
.header-title { font-size: 20px; font-weight: 700; color: #fff; }

.status-wrap { display: flex; flex-direction: column; align-items: center; padding: 80px 0; }
.status-text { font-size: 14px; color: #999; }

.content { padding: 16px; }
.card { background: #fff; border-radius: 12px; padding: 0 16px; }
.card-row { display: flex; justify-content: space-between; align-items: center; padding: 16px 0; }
.label { font-size: 14px; color: #999; }
.value { font-size: 15px; color: #333; font-weight: 500; }
.status.confirmed { color: #27ae60; font-weight: 600; }
.status.pending { color: #f39c12; font-weight: 600; }
.divider { height: 1px; background: #f0f0f0; }
