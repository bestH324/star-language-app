<view class="page">
    <view class="header">
        <view class="header-back" bindtap="handleBack">← 返回</view>
        <text class="header-title">预约详情</text>
    </view>

    <view wx:if="{{loading}}" class="status-wrap">
        <text class="status-text">加载中...</text>
    </view>

    <view wx:elif="{{!detail}}" class="status-wrap">
        <text class="status-text">未找到该预约记录</text>
    </view>

    <view wx:else class="content">
        <view class="card">
            <view class="card-row">
                <text class="label">就诊机构</text>
                <text class="value">{{detail.hospital_name}}</text>
            </view>
            <view class="divider"></view>
            <view class="card-row">
                <text class="label">预约状态</text>
                <text class="value status {{detail.status === '已确认' ? 'confirmed' : 'pending'}}">{{detail.status}}</text>
            </view>
            <view class="divider"></view>
            <view class="card-row">
                <text class="label">就诊儿童</text>
                <text class="value">{{detail.child_name}}</text>
            </view>
            <view class="divider"></view>
            <view class="card-row">
                <text class="label">预约类型</text>
                <text class="value">{{detail.type}}</text>
            </view>
            <view class="divider"></view>
            <view class="card-row">
                <text class="label">预约时间</text>
                <text class="value">{{detail.appointment_time}}</text>
            </view>
        </view>
    </view>
</view>
