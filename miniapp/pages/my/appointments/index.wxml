<view class="page">
    <view class="header">
        <view class="header-back" bindtap="handleBack">← 返回</view>
        <text class="header-title">我的预约</text>
    </view>

    <view wx:if="{{loading}}" class="status-wrap">
        <text class="status-text">加载中...</text>
    </view>

    <view wx:elif="{{list.length === 0}}" class="status-wrap">
        <text class="empty-icon">📋</text>
        <text class="status-text">暂无预约记录</text>
    </view>

    <view wx:else class="list">
        <view wx:for="{{list}}" wx:key="id" class="card" bindtap="onTapItem" data-id="{{item.id}}">
            <view class="card-top">
                <text class="card-name">{{item.hospital_name}}</text>
                <text class="card-status {{item.status === '已确认' ? 'confirmed' : 'pending'}}">{{item.status}}</text>
            </view>
            <view class="card-meta">
                <text class="meta-item">👶 {{item.child_name}}</text>
                <text class="meta-item">📌 {{item.type}}</text>
                <text class="meta-item">📅 {{item.appointment_time}}</text>
            </view>
        </view>
    </view>
</view>
